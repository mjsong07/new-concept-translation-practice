{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "new-concept-pronunciation",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://mjsong07.github.io,http://localhost:5173,http://127.0.0.1:5173"
  }
}
